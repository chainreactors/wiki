# 仓库统一用 LF：Windows/WSL 上的编辑器曾把整批 md 改成 CRLF，
# 导致几千行的"假改动"。下面这些类型入库时强制归一化。
* text=auto eol=lf

*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.svg  text eol=lf

# 二进制资源不要碰
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff2 binary
